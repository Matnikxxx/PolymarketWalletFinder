# ============================================================
# Polymarket Wallet Finder / Tracker configuration
# Copy this file to .env and edit values as needed.
# NEVER put a private key in here. This system never needs one --
# it never places, simulates, or copies an order.
# ============================================================

# --- WALLET TRACKING / POLLING --------------------------------
CHECK_INTERVAL=5
REQUEST_TIMEOUT=15
MAX_RETRIES=5
BACKOFF_BASE=0.5

# --- WALLET FILTER THRESHOLDS ---------------------------------
MIN_ROI=15
PREFERRED_ROI_MIN=20
PREFERRED_ROI_MAX=30
REJECT_ROI_ABOVE=80
MIN_POSITIONS=40
MIN_CONSISTENCY=4.4
MAX_DRAWDOWN=20
MIN_ACTIVE_DAYS=30
BREAKEVEN_TOLERANCE_USDC=0.01

# --- WALLET DISCOVERY ---------------------------------------------
# MAX_WALLET_CANDIDATES is the hard cap on candidate wallets per scan
# (leaderboard candidates + seed candidates combined).
MAX_WALLET_CANDIDATES=30
# Leaderboard pagination: rows requested per page (Polymarket caps this at
# 50 server-side; values above 50 are clamped to 50 by the scanner), and
# the maximum number of paged requests a single scan will make. Together they
# bound how many candidates are reachable: MAX_LEADERBOARD_PAGES x
# LEADERBOARD_PAGE_SIZE rows, plus the seed list. Pagination stops early on an
# empty page, a repeated page (API ignoring offset) or an API error; a page
# that comes back shorter than requested is walked through, not treated as the
# end of the leaderboard.
LEADERBOARD_PAGE_SIZE=50
MAX_LEADERBOARD_PAGES=10
# Raising MAX_WALLET_CANDIDATES above MAX_LEADERBOARD_PAGES x
# LEADERBOARD_PAGE_SIZE (+ seeds) has no effect -- the scan diagnostics print
# the effective values and say which knob is the binding one.
# NOTE: a variable exported in your shell/IDE overrides this file; the scan
# diagnostics name the source of every discovery setting.

# --- WALLET HISTORY (per-wallet analytics) ---------------------------
# Pages fetched per feed per wallet, newest first.
#   1 page = 100 /activity fills  OR  50 /closed-positions rows
# Default 30  -> up to 3,000 fills and 1,500 closed positions per wallet.
# This is THIS PROJECT'S safety bound, not a Polymarket API limit; the only
# vendor-side cap is rows per request (50). Raising it measures more history
# (and can legitimately change active_days/lifetime metrics for a wallet that
# was previously truncated) at a linear cost in requests: up to
# 2 x MAX_HISTORY_PAGES history calls per wallet, plus /positions and /value.
# The client retries with exponential backoff (MAX_RETRIES / BACKOFF_BASE);
# raise this in steps rather than jumping to a very large value.
# Reaching the cap marks the wallet PARTIAL (history truncated); a short page
# proves COMPLETE. See README section "5f. Historical data completeness".
MAX_HISTORY_PAGES=30

# --- TRADING FREQUENCY / RAPID-TRADE DETECTION ----------------------
# Used for wallet-cadence classification (scoring/filtering) AND as a
# live, informational-only diagnostic flag during --track-wallets --
# it never rejects/delays/resizes anything (there's nothing to act on:
# tracking only observes).
RAPID_TRADE_ENABLED=true
MIN_SECONDS_BETWEEN_TRADES=5
RAPID_WINDOW_SECONDS=60
MAX_TRADES_IN_WINDOW=10
MAX_SHORT_INTERVAL_PERCENT=25
HIGH_FREQUENCY_TRADES_PER_DAY=10
HIGH_FREQUENCY_MEDIAN_GAP_SECONDS=3600
LOW_FREQUENCY_MAX_TRADES_PER_DAY=0.34
BOT_LIKE_MAX_TRADES_IN_1M=10
BOT_LIKE_PCT_WITHIN_10S=50
MIN_TRADES_FOR_FREQUENCY_CLASSIFICATION=3
FREQUENCY_SCORE_PENALTY=15
BOT_LIKE_SCORE_PENALTY=40

# --- CATEGORY PREFERENCES -----------------------------------------
POLITICS_ALLOWED=false
SPORTS_PREFERRED=true
CRYPTO_PREFERRED=true

# --- API -------------------------------------------------------------
POLYMARKET_DATA_API_BASE=https://data-api.polymarket.com
POLYMARKET_GAMMA_API_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_BASE=https://clob.polymarket.com

# --- LOGGING -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=data/bot.log
